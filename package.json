{
  "name": "dsh-deepseek-web",
  "version": "0.1.0",
  "description": "DeepSeek 网页版（chat.deepseek.com）的左侧栏入口与内嵌面板，适用于 DeepSeek Harness 桌面端。",
  "license": "MIT",
  "author": "周静远",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brokewaves/deepseek-harness-web.git"
  },
  "homepage": "https://github.com/brokewaves/deepseek-harness-web#readme",
  "bugs": {
    "url": "https://github.com/brokewaves/deepseek-harness-web/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "webview",
    "chat"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
